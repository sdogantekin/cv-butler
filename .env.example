# Auth.js (Google-only login for v1)
AUTH_SECRET=your_auth_secret_here
# Generate a real one with: npx auth secret
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# LLM provider (env-var-driven; switching provider is a .env change, not a code change)
LLM_PROVIDER=anthropic
# anthropic | qwen | openai | deepseek | gemini

# --- Anthropic (Claude) — v1 default ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Qwen (via an OpenAI-compatible cloud endpoint — hosting varies, no single official base URL) ---
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://your-openai-compatible-qwen-endpoint/v1
QWEN_MODEL=qwen-plus

# --- OpenAI ---
OPENAI_API_KEY=sk-xxx
# Verify/pin the exact current model id — placeholder only:
OPENAI_MODEL=gpt-5

# --- DeepSeek (OpenAI-compatible API; base URL defaults to their official endpoint) ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Verify/pin the exact current model id — placeholder only:
DEEPSEEK_MODEL=deepseek-chat

# --- Gemini (Google AI Studio API key, not Vertex AI/GCP service accounts) ---
GEMINI_API_KEY=your_gemini_api_key
# Verify/pin the exact current model id — placeholder only:
GEMINI_MODEL=gemini-2.5-pro

# Database — SQLite is the local-dev default (zero config, file at
# SQLITE_DB_PATH). Set DATABASE_URL to switch this app to Postgres instead —
# used automatically in production on Vercel via the Neon integration, which
# injects DATABASE_URL for you. Leave DATABASE_URL unset for local development.
SQLITE_DB_PATH=./local.db
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Shared daily action pool (ATS score + JD match together). Bump this during
# local/manual testing to avoid hitting the limit; defaults to 3 if unset.
DAILY_ACTION_LIMIT=3
